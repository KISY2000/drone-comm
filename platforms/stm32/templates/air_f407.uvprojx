<?xml version='1.0' encoding='utf-8'?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>air_f407_comm_library</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6220000::V6.22::ARMCLANG</pCCUsed>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32F407ZG</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil::STM32F4xx_DFP@3.1.1</PackID>
          <PackURL>https://www.keil.com/pack/</PackURL>
          <Cpu>IRAM(0x20000000,0x20000) IROM(0x08000000,0x100000) CPUTYPE("Cortex-M4") CLOCK(8000000) ELITTLE</Cpu>
          <OutputDirectory>..\..\..\build\keil\air_f407\</OutputDirectory>
          <OutputName>air_f407_comm</OutputName>
          <CreateExecutable>0</CreateExecutable>
          <CreateLib>1</CreateLib>
          <CreateHexFile>0</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <ListingPath>..\..\..\build\keil\air_f407\</ListingPath>
        </TargetCommonOption>
        <TargetArmAds>
          <ArmAdsMisc>
            <AdsCpuType>"Cortex-M4"</AdsCpuType>
          </ArmAdsMisc>
          <Cads>
            <Optim>1</Optim>
            <wLevel>2</wLevel>
            <uC99>1</uC99>
            <v6Lang>1</v6Lang>
            <VariousControls>
              <MiscControls>-std=c99</MiscControls>
              <Define>USE_HAL_DRIVER STM32F407xx DC_ROLE_AIR_F407</Define>
              <Undefine />
              <IncludePath>..\..\..\include;..\..\common;..\common;..\f4;..\..\..\deps\stm32f4xx-hal-driver-1.8.5\Inc;..\..\..\deps\cmsis-device-f4-2.6.11\Include;..\..\..\deps\CMSIS_5-5.9.0\CMSIS\Core\Include</IncludePath>
            </VariousControls>
          </Cads>
        </TargetArmAds>
      </TargetOption>
