<?xml version='1.0' encoding='utf-8'?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>ground_f407_standalone_disabled</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6220000::V6.22::ARMCLANG</pCCUsed>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32F407ZG</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil::STM32F4xx_DFP@3.1.1</PackID>
          <PackURL>https://www.keil.com/pack/</PackURL>
          <Cpu>IRAM(0x20000000,0x20000) IROM(0x08000000,0x100000) CPUTYPE("Cortex-M4") CLOCK(8000000) ELITTLE</Cpu>
          <OutputDirectory>..\..\..\build\stm32_standalone\default_disabled\ground_f407\</OutputDirectory>
          <ListingPath>..\..\..\build\stm32_standalone\default_disabled\ground_f407\</ListingPath>
          <OutputName>ground_f407_disabled</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateLib>0</CreateLib>
          <CreateHexFile>0</CreateHexFile>
          <DebugInformation>1</DebugInformation>
        </TargetCommonOption>
        <TargetArmAds>
          <ArmAdsMisc>
            <AdsCpuType>"Cortex-M4"</AdsCpuType>
            <useUlib>1</useUlib>
            <AdsLLst>1</AdsLLst>
            <AdsLmap>1</AdsLmap>
            <AdsLcgr>1</AdsLcgr>
            <AdsLsym>1</AdsLsym>
            <AdsLszi>1</AdsLszi>
          </ArmAdsMisc>
          <Cads>
            <Optim>2</Optim>
            <wLevel>2</wLevel>
            <uC99>1</uC99>
            <v6Lang>1</v6Lang>
            <v6Lto>0</v6Lto>
            <VariousControls>
              <MiscControls>-std=c99</MiscControls>
              <Define>USE_HAL_DRIVER STM32F407xx DC_ROLE_GROUND_F407 DC_BOARD_READY=0 HSE_VALUE=8000000U</Define>
              <Undefine />
              <IncludePath>..\..\..\include;..\..\common;..\common;..\f4;..\..\..\deps\stm32f4xx-hal-driver-1.8.5\Inc;..\..\..\deps\cmsis-device-f4-2.6.11\Include;..\..\..\deps\CMSIS_5-5.9.0\CMSIS\Core\Include</IncludePath>
            </VariousControls>
          </Cads>
          <Aads>
            <ClangAsOpt>1</ClangAsOpt>
            <VariousControls />
          </Aads>
          <LDads>
            <umfTarg>0</umfTarg>
            <useFile>1</useFile>
            <noStLib>0</noStLib>
            <RepFail>1</RepFail>
            <ScatterFile>ground_f407.sct</ScatterFile>
            <Misc>--entry=Reset_Handler --strict</Misc>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
